{
  "version": "cross-sport-data-layer-v2.1",
  "policy": {
    "free_only": true,
    "production_default_requires_pit": true,
    "unknown_availability_is_fail_closed": true,
    "research_only_candidates_are_never_auto_promoted": true,
    "credentials_never_auto_created": true
  },
  "evidence": {
    "thesportsdb": {
      "current_web_evidence": "2026-09-27",
      "status": "strong_research_candidate",
      "note": "Free JSON API. Current public database pages show all nine target sports/competition families. Best suited to cross-sport event/participant/league/venue/standings enrichment rather than Opta-depth event statistics.",
      "references": [
        "https://www.thesportsdb.com/api.php",
        "https://www.thesportsdb.com/sport.php",
        "https://www.thesportsdb.com/season/4491-rizin-ff/2026",
        "https://www.thesportsdb.com/league/5422-Valorant-Champions-Tour"
      ]
    },
    "espn_public": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Public ESPN API documentation/implementations expose broad coverage across basketball, racing, tennis, MMA, rugby and volleyball, plus rosters, injuries, transactions, news and statistics. Treat the surface as public/undocumented and reconstruct availability conservatively.",
      "references": [
        "https://github.com/sejaldua/espn-api",
        "https://github.com/sejaldua/espn-api/blob/main/references/endpoints.md"
      ]
    },
    "odds_api_io": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Provider advertises a free tier of 100 requests/hour and 500/day across 34 sports. Direct pages confirm basketball, tennis, MMA including Rizin, boxing, rugby and Valorant/esports. Use only as market-signal enrichment; bookmaker publication timestamps are required for historical PIT.",
      "references": [
        "https://odds-api.io/sports",
        "https://odds-api.io/sports/mma",
        "https://odds-api.io/sports/boxing",
        "https://odds-api.io/sports/rugby",
        "https://odds-api.io/sports/tennis",
        "https://odds-api.io/esports/valorant"
      ],
      "terms_note": "Current free-tier page states free is for development/testing/personal projects; commercial production requires paid access. Keep out of commercial production unless terms permit."
    },
    "specialist_open_datasets": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Open datasets can add higher-granularity research features but often lack historical availability timestamps. Keep PIT-gated.",
      "references": [
        "https://github.com/livetennisapi/livetennisapi-data",
        "https://github.com/komaksym/UFC-DataLab",
        "https://github.com/serp-ai/boxing-punch-recognition-dataset",
        "https://github.com/opensport/rugby.db",
        "https://github.com/Veloruze/vlr-gg-api"
      ]
    },
    "f1_community_dataset": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Community F1 dataset currently reports 1950-2026 coverage and CC0 licensing; use as redundancy/research corpus rather than replacing OpenF1/Jolpica.",
      "references": [
        "https://www.kaggle.com/general/734039"
      ]
    },
    "cross_sport_context": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Non-sport-specific context sources can improve venue conditions, travel/rest context, entity resolution and external-information awareness across multiple target sports. They remain separate from direct match-stat feeds.",
      "sources": {
        "gdelt": {
          "free": true,
          "pit": "publication/capture provenance required",
          "use": [
            "news",
            "event context",
            "information shocks"
          ],
          "reference": "https://www.gdelt.org/"
        },
        "open_meteo": {
          "free": true,
          "pit": "forecast-run timestamp required for prediction replay",
          "use": [
            "weather",
            "wind",
            "temperature",
            "precipitation",
            "air quality"
          ],
          "reference": "https://github.com/open-meteo/open-meteo"
        },
        "openstreetmap_overpass": {
          "free": true,
          "pit": "static/geographic data snapshot provenance required",
          "use": [
            "venue location",
            "travel distance",
            "surface/venue context"
          ],
          "reference": "https://wiki.openstreetmap.org/wiki/Overpass_API"
        },
        "wikidata": {
          "free": true,
          "pit": "entity snapshot/version provenance required",
          "use": [
            "athlete/team/entity resolution",
            "country",
            "biographical metadata"
          ],
          "reference": "https://www.wikidata.org/wiki/Wikidata:Data_access/en"
        }
      }
    },
    "sportscore": {
      "current_web_evidence": "2026-09-27",
      "status": "research_candidate",
      "note": "Documented public REST API covering football, basketball, cricket and tennis; no API key for open-source/attribution use, with an advertised free quota. Useful as an independent redundancy source for basketball/tennis.",
      "references": [
        "https://sportscore.com/developers/",
        "https://sportscore.com/developers/api/"
      ]
    },
    "discovery_aggregator": {
      "current_web_evidence": "2026-09-27",
      "status": "discovery_only",
      "note": "mcp-sports-hub aggregates 40+ providers and identifies no-key/free providers. It is used as a provider-discovery index only, not as a production data source.",
      "references": [
        "https://github.com/lacausecrypto/mcp-sports-hub"
      ]
    }
  },
