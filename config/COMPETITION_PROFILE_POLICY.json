    {
      "profile_id": "valorant:ecosystem",
      "sport": "valorant",
      "phase_type": "circuit",
      "rules_profile": "valorant",
      "aliases": [
        "valorant"
      ],
      "canonical_competition_id": "valorant:ecosystem"
    }
  ],
  "dynamic_competition_discovery": [
    "valorant"
  ],
  "rules": {
    "dynamic_profiles_are_research_only": true,
    "dynamic_profile_requires_nonempty_explicit_competition_id": true
  },
  "hierarchical_routing": {
    "enabled": true,
    "mode": "research_then_production",
    "strategy": "most_specific_accepted_else_broader_accepted_else_sport_incumbent",
    "no_implicit_pooling": true,
    "no_context_inference": true,
    "contexts_must_be_explicit_event_fields": true
  },
  "segment_policy": {
    "basketball": {
      "levels": [
        "season",
        "stage",
        "round",
        "event_type"
      ],
      "minimum_explicit_context": 1,
      "max_depth": 4
    },
    "volleyball": {
      "levels": [
        "season",
        "stage",
        "round",
        "event_type"
      ],
      "minimum_explicit_context": 1,
      "max_depth": 4
    },
    "ufc": {
      "levels": [
        "season",
        "event_type"
      ],
      "minimum_explicit_context": 1,
      "max_depth": 2
    },
    "rizin": {
      "levels": [
        "season",
        "event_type"
      ],
      "minimum_explicit_context": 1,
      "max_depth": 2
    },
    "valorant": {
      "levels": [
        "season",
        "stage",
        "round",
        "event_type"
      ],
      "minimum_explicit_context": 1,
      "max_depth": 4
    }
  }
