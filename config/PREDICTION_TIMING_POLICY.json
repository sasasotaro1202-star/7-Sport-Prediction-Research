{
  "version": 2,
  "policy": "adaptive-prediction-timing-v1",
  "default_preferred_lead_minutes": 60,
  "allowed_lead_minutes": [
    15,
    20,
    30,
    45,
    60,
    90
  ],
  "bounds": {
    "minimum_lead_minutes": 5,
    "maximum_lead_minutes": 180
  },
  "selection": {
    "mode": "research_then_production",
    "production_default": 60,
    "choose_from_allowed_leads_only": true,
    "optimize_for": [
      "information_value",
      "forecast_stability",
      "calibration",
      "freshness",
      "revision_risk",
      "PIT_safety",
      "latency",
      "coverage"
    ],
    "require_oos_timing_evidence_for_nondefault": true,
    "require_frozen_holdout_for_nondefault": true,
    "min_relative_logloss_improvement": 0.03,
    "min_folds_not_worse": 0.7,
    "holdout_brier_tolerance": 0.001,
    "holdout_ece_tolerance": 0.01,
    "bootstrap_probability_improvement": 0.9,
    "bootstrap_samples": 600
  },
  "actions": {
    "initial_prediction": "preferred_or_selected_lead",
    "refresh": "allowed_when_expected_prediction_change_or_uncertainty_reduction_justifies_cost",
    "late_recovery": true,
    "abstain_or_fallback": true
  },
  "safety": {
    "prediction_cutoff_is_event_time_minus_actual_selected_lead": true,
    "feature_availability_must_be_at_or_before_cutoff": true,
    "no_post_cutoff_information": true,
    "route_artifact_must_be_accepted": true,
    "default_on_missing_or_invalid_route": true,
    "feature_cutoff_must_not_exceed_prediction_cutoff": true
  },
  "scheduler": {
    "guideline_target_minutes": 60,
    "guideline_tolerance_minutes": 15,
    "target_lead_minutes": 60,
    "guideline_only": true,
    "selection_mode": "adaptive-capable;60m-default",
    "shadow_rotation_minutes": 15,
    "shadow_leads_minutes": [
      60,
      45,
      20,
      15,
      90
    ]
  },
  "minimums": {
    "timing_rows": 120,
    "holdout_rows": 30,
    "folds": 4,
    "min_test_rows_per_fold": 15,
    "periods": 2
  }
}
