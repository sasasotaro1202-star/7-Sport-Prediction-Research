{
  "version": 8,
  "policy": "source-feasibility-and-pit-separation-v8",
  "principle": [
    "Reachability is not historical availability.",
    "Non-empty HTML/JSON is not sufficient; required signals must be observed.",
    "A reachable source may still be PIT_UNPROVEN.",
    "Paid/commercial sources are never required for the active free-source audit.",
    "At least one critical event/schedule source must be reachable for each active sport; otherwise the sport is DATA_SOURCE_OUTAGE.",
    "Historical/PIT readiness remains a separate gate."
  ],
