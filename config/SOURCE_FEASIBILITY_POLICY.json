  "feature_pattern_rules": {
    "must_search_all_active_sports": true,
    "selection_is_chronological": true,
    "holdout_is_score_only": true,
    "unknown_pit_is_fail_closed": true,
    "no_missing_to_zero": true,
    "source_value_is_not_feature_value": true,
    "preferred_pattern_dimensions": [
      "family",
      "difference",
      "ratio",
      "trend",
      "rolling_window",
      "recency_weight",
      "interaction",
      "missingness",
