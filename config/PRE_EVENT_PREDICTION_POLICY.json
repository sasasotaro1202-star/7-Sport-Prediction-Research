{
  "version": 2,
  "policy": "pre-event-prediction-v2",
  "scheduler": {
    "cron_utc": "3-58/5 * * * *",
    "minimum_interval_minutes": 5,
    "manual_dispatch": true,
    "generation_window": {
      "min_lead_minutes": 5,
      "max_lead_minutes": 180,
      "late_recovery": true,
      "scheduled_min_lead_minutes": 45,
      "scheduled_max_lead_minutes": 75
    },
    "guideline_target_minutes": 60,
    "guideline_tolerance_minutes": 15,
    "target_lead_minutes": 60,
    "note": "60 minutes is the scheduled target/guideline. Scheduled generation accepts a 45-75 minute lead window. User-requested manual predictions may specify another lead from 5 to 180 minutes.",
    "guideline_only": true,
    "selection_mode": "scheduled-60m-default;manual-lead-configurable"
  },
  "scope": {
    "active_prediction_scope_only": true,
    "competition_profile_required": true,
    "unknown_competition_fail_closed": true
  },
  "pit": {
    "prediction_cutoff": "event_time_minus_selected_lead",
    "feature_pit_lead_minutes": 60,
    "post_cutoff_information_forbidden": true,
    "allow_timing_deviation": true,
    "max_guideline_deviation_minutes": 15
  },
  "experience": {
    "archive_forward_predictions": true,
    "score_verified_outcomes_only": true,
    "store_competition_context": true,
    "research_signals_only_until_oos_validation": true,
    "shadow_timing_rotation": true,
    "mature_event_unit_required": true,
    "revision_count_is_not_an_experience_sample": true
  },
  "safety": {
    "production_model_promotion": false,
    "safe_prior_fallback_allowed": true,
    "missing_prediction_is_explicit_gap": true,
    "no_failure_hiding": true
  },
  "explanation": "Scheduled predictions target approximately one hour before the event. Non-default horizons remain research-controlled, while explicit user requests may use another lead through workflow dispatch or the fresh-prediction entrypoint."
}
