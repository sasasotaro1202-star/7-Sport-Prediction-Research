{
  "version": 1,
  "policy": "pre-event-prediction-v1",
  "scheduler": {
    "cron_utc": "3-58/5 * * * *",
    "minimum_interval_minutes": 5,
    "manual_dispatch": true,
    "generation_window": {
      "min_lead_minutes": 5,
      "max_lead_minutes": 180,
      "late_recovery": true
    },
    "guideline_target_minutes": 60,
    "guideline_tolerance_minutes": 15,
    "target_lead_minutes": 60,
    "note": "60 minutes is the default target/guideline; actual generation may move earlier or later when an accepted timing route or freshness/information policy justifies it.",
    "guideline_only": true,
    "selection_mode": "adaptive-capable;60m-default"
  },
  "scope": {
    "active_prediction_scope_only": true,
    "competition_profile_required": true,
    "unknown_competition_fail_closed": true
  },
  "pit": {
    "prediction_cutoff": "event_time_minus_selected_lead",
    "feature_pit_lead_minutes": 60,
    "post_cutoff_information_forbidden": true,
    "allow_timing_deviation": true,
    "max_guideline_deviation_minutes": 15
  },
  "experience": {
    "archive_forward_predictions": true,
    "score_verified_outcomes_only": true,
    "store_competition_context": true,
    "research_signals_only_until_oos_validation": true,
    "shadow_timing_rotation": true
  },
  "safety": {
    "production_model_promotion": false,
    "safe_prior_fallback_allowed": true,
    "missing_prediction_is_explicit_gap": true,
    "no_failure_hiding": true
  },
  "explanation": "60 minutes is the preferred default target. Actual prediction timing may be earlier/later when an evidence-backed timing policy selects it; manual requests may specify another lead."
}
